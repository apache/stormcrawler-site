<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for p in site.pages %}{% assign ext = p.url | split: '.' | last %}{% assign lastchar = p.url | slice: -1 %}{% if lastchar == '/' or ext == 'html' %}{% unless p.url contains '/404' or p.url contains '/getting-started/' %}  <url><loc>{{ p.url | replace:'index.html','' | prepend: site.baseurl | prepend: site.url }}</loc></url>
{% endunless %}{% endif %}{% endfor %}  <url><loc>{{ site.url }}{{ site.baseurl }}/docs/latest/index.html</loc></url>
</urlset>
